# Copy to .env for local development. Every field in src/a11y_assist/config.py
# can be set here or as an environment variable.

# stdio is how Claude Code launches a local MCP server.
MCP_TRANSPORT=stdio

# Top-level navigation allowlist (JSON list). ".gov" matches any *.gov host.
ALLOWED_DOMAINS=[".gov", ".mil"]

# Allow file:// pages (local fixtures only). Never enable for real audits.
DEV_MODE=false

# "chrome" = installed Google Chrome (default). "chromium" = Playwright's build.
BROWSER_CHANNEL=chrome
HEADLESS=false

MAX_TAB_PRESSES=150

# Recorded in every report. No rules spec exists yet.
RULES_SPEC_VERSION=none
JUDGING_MODEL=none
