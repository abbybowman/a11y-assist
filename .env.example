# Copy to .env for local development. Every field in src/a11y_assist/config.py
# can be set here or as an environment variable.

# stdio is how Claude Code launches a local MCP server. streamable-http
# listens on MCP_HOST:MCP_PORT, loopback only (127.0.0.1 or ::1), with
# Host/Origin checks; there is no authentication yet. PORT and
# DATABRICKS_APP_PORT are ignored.
MCP_TRANSPORT=stdio

# Top-level navigation allowlist (JSON list). ".gov" matches any *.gov host.
ALLOWED_DOMAINS=[".gov", ".mil"]

# Allow file:// pages (local fixtures only). Never enable for real audits.
DEV_MODE=false

# Every browser connection is checked: hosts resolving to private, loopback,
# link-local, multicast, reserved or cloud-metadata addresses are refused.
EGRESS_PORTS=[80, 443]
# Dev mode only: addresses let through anyway, for a local test server.
DEV_ALLOWED_ADDRESSES=[]

# "chrome" = installed Google Chrome (default). "chromium" = Playwright's build.
BROWSER_CHANNEL=chrome
HEADLESS=false

# Recorded in every report. Rules spec versions come from docs/rules/ front
# matter and are not set here.
JUDGE_BACKEND=client
JUDGING_MODEL=none

# Evals only (docs/plans/2026-10-31-agent-eval.md). Leave unset for real use.
# A folder of frozen recordings: "replay" serves only those pages; a URL with
# none is a tool error. "tested_frozen" (the agent eval): the tested page from
# the folder, other pages of its site live. "record_missing" records into it.
# FROZEN_PAGES_DIR=
# FROZEN_PAGES_MODE=replay
# The agent eval's model route (evals/agent/providers.py). Never commit a key.
# AGENT_API_BASE=https://api.asksage.ai.nasa.gov/server/anthropic
# AGENT_API_KEY=
# AGENT_API_AUTH_HEADER=x-api-key
# AGENT_MODEL=claude-sonnet-5-5-gov
# AGENT_LEAK_VALUES=
